{
  "name": "@hudrazine/pi-exa-web",
  "version": "0.1.0",
  "description": "Exa-powered web search and page fetching tools for Pi.",
  "keywords": [
    "exa",
    "mcp",
    "pi",
    "pi-package",
    "web-search"
  ],
  "homepage": "https://github.com/hudrazine/pi-exa-web#readme",
  "bugs": {
    "url": "https://github.com/hudrazine/pi-exa-web/issues"
  },
  "license": "MIT",
  "author": "hudrazine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hudrazine/pi-exa-web.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vp test",
    "check": "vp check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "vp run check && vp run test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^26.1.1",
    "typebox": "^1.3.14",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
